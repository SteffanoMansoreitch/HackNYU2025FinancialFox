<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/styles.css">
    <title>nyuhack2025</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Poppins:wght@100;900&family=Quicksand:wght@300..700&family=Roboto+Mono:wght@100..700&family=Spinnaker&display=swap" rel="stylesheet">

    <!-- ✅ FIXED: Added default value for spritePosition -->
    <style>
        .sprite {
            background-position: "<%= spritePosition || '0px 0px' %>;"
        }
    </style>
</head>
<body>
    <div class="header">
        <div class="name">
            <h1 class="profile-name"><%= data.name %>'s Pet</h1>
        </div>

        <div class="profile">
            <div><h2>Finance Fox</h2></div>
            <div class="pet-profile">
                <div class="sprite"></div>
                <div class="advice"><p>Some advice to give</p></div>
            </div> <!-- ✅ Closing div added -->
        </div>
    </div>

    <div class="data-container">
        <div class="container monthly-data">
            <div class="progress-section">
                <h2>Monthly Expenses</h2>

                <!-- ✅ REFACTORED: Loop for monthly expenses -->
                <% const categories = ["rent", "transport", "food", "entertainment", "utilities", "healthcare", "misc"]; %>
                <% categories.forEach(category => { %>
                    <div class="progress-item">
                        <div class="progress-label">
                            <span><%= category.charAt(0).toUpperCase() + category.slice(1) %></span>
                            <span>$<%= data[category] %></span>
                        </div>
                        <div class="progress-bar-container">
                            <div class="progress-bar" style="width: 50%;"></div> 
                        </div>
                    </div>
                <% }) %>
            </div>
        </div>

        <div class="container progress-data">
            <h2>Goals</h2>
            <div class="progress-section">
                <div class="progress-item">
                    <div class="progress-label">
                        <span>Emergency Fund</span>
                        <span>50%</span>
                    </div>
                    <!-- Make sure this opening tag is closed properly -->
                    <div class="progress-bar-container">
                        <div class="progress-bar" style="width: 50%;"></div>
                    </div>
                </div>
                <div class="progress-item">
                    <div class="progress-label">
                        <span>Retirement Fund</span>
                        <span>30%</span>
                    </div>
                    <div class="progress-bar-container">
                        <div class="progress-bar" style="width: 30%;"></div>
                    </div>
                </div>
                <div class="progress-item">
                    <div class="progress-label">
                        <span>Vacation Fund</span>
                        <span>70%</span>
                    </div>
                    <div class="progress-bar-container">
                        <div class="progress-bar" style="width: 70%;"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ✅ FIXED: JS Object Syntax (quotes, commas, numbers) -->
    <script>
        const data = "<%- JSON.stringify(data) %>";
    </script>
    <script src="/index.js"></script>    

    <script src="/index.js"></script>
</body>
</html>
